<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
{%- capture target %}{% render 'target' %}{% endcapture -%}
{%- if template.name != "password" %}
<meta http-equiv="refresh" content="0; url={{ target }}">
<script>location.replace({{ target | json }})</script>
{%- endif %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<link rel="canonical" href="{{ canonical_url }}">
{{ content_for_header }}
<style>
:root { --accent: #008cff; --bg: #f8f8f9; --fg: #000000; }
@media (prefers-color-scheme: dark) { :root { --bg: #070707; --fg: #ffffff; } }
html { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
main { text-align: center; padding: 2rem; }
a { color: var(--accent); }
h1 { font-weight: 600; font-size: 1.25rem; margin: 0 0 1rem; }
form { margin-top: 1rem; }
table { margin: 0 auto 1rem; border-collapse: collapse; }
td { padding: .25rem .75rem; }
</style>
</head>
<body>
<main>
{{ content_for_layout }}
</main>
</body>
</html>
