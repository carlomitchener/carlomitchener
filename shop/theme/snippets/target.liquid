{%- liquid
  assign site = "https://carlomitchener.com"
  case template.name
    when "product"
      assign parts = product.handle | split: "-"
      assign primary = parts | first
      assign design = parts | last
      assign slug = product.handle | remove_first: primary | remove_first: "-" | remove_last: design | remove_last: "-"
      if design.size == 8 and slug != blank and parts.size > 2
        echo site | append: "/shop/" | append: slug | append: "/" | append: design | append: "/"
      else
        echo site | append: "/"
      endif
    when "collection", "search", "list-collections"
      echo site | append: "/shop/"
    when "cart"
      echo site | append: "/cart/"
    when "page"
      assign docs = "shipping,faq,terms" | split: ","
      if docs contains page.handle
        echo site | append: "/shop/" | append: page.handle | append: "/"
      else
        echo site | append: "/" | append: page.handle | append: "/"
      endif
    else
      echo site | append: "/"
  endcase
-%}
