{% layout none %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ shop.name }} gift card</title>
{{ content_for_header }}
<style>
:root { --accent: #008cff; --bg: #f8f8f9; --fg: #000000; }
@media (prefers-color-scheme: dark) { :root { --bg: #070707; --fg: #ffffff; } }
html { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
main { text-align: center; padding: 2rem; }
a { color: var(--accent); }
h1 { font-weight: 600; font-size: 1.25rem; margin: 0 0 1rem; }
.value { font-size: 2rem; font-weight: 600; margin: 0; }
code { display: block; margin: 1rem 0; font: 1.5rem/1 ui-monospace, monospace; letter-spacing: .1em; user-select: all; }
.fine { opacity: .6; font-size: .875rem; }
button { font: inherit; padding: .5rem 1rem; margin-top: 1rem; }
@media print { button { display: none; } }
</style>
</head>
<body>
<main>
<h1>{{ shop.name }}</h1>
<p class="value">{{ gift_card.initial_value | money }}</p>
{% if gift_card.balance != gift_card.initial_value %}
<p>Balance {{ gift_card.balance | money }}</p>
{% endif %}
<code>{{ gift_card.code | format_code }}</code>
{% if gift_card.expired %}
<p class="fine">Expired</p>
{% elsif gift_card.expires_on %}
<p class="fine">Expires {{ gift_card.expires_on | date: "%B %-d, %Y" }}</p>
{% endif %}
{% unless gift_card.enabled %}
<p class="fine">Disabled</p>
{% endunless %}
<p><a href="https://carlomitchener.com/">Shop now</a></p>
<button type="button" onclick="print()">Print</button>
</main>
</body>
</html>
