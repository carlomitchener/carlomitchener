{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "paths": {
      "mrly-*/wasm": ["../../../mrlyprod/mrlyprod/data/packages/bindgen/js/*/index"],
      "mrly-loader": ["../../../mrlyprod/mrlyprod/packages/loader/src/index.ts"],
      "mrly-draw": ["../../../mrlyprod/mrlyprod/packages/draw/src/index.ts"],
      "mrly-draw/*": ["../../../mrlyprod/mrlyprod/packages/draw/src/*"]
    }
  },
  "include": ["*/figures/*.ts", "shared/figures/*.ts"],
  "exclude": ["**/node_modules/**", "**/data/**", "**/target/**"]
}
