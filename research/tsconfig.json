{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "paths": {
      "@mrlyprod/*": ["../../../mrlyprod/mrlyprod/data/packages/rs/bindgen/js/*/index", "../../../mrlyprod/mrlyprod/data/packages/rs/bindgen/js/*"],
      "@mrlyprod/loader": ["../../../mrlyprod/mrlyprod/packages/js/loader/src/index.ts"],
      "@mrlyprod/draw": ["../../../mrlyprod/mrlyprod/packages/js/draw/src/index.ts"],
      "@mrlyprod/draw/*": ["../../../mrlyprod/mrlyprod/packages/js/draw/src/*"]
    }
  },
  "include": ["*/figures/*.ts", "shared/figures/*.ts"],
  "exclude": ["**/node_modules/**", "**/data/**", "**/target/**"]
}
