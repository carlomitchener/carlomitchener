{
  "name": "carlomitchener",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "net": "bun net/build.ts",
    "dev": "bun dev.ts",
    "stats": "bun stats.ts",
    "deploy": "bun stats.ts && bun run build && wrangler deploy",
    "ship": "bun ship.ts",
    "deploy:net": "bun stats.ts && bun ship.ts && wrangler deploy -c wrangler.net.jsonc",
