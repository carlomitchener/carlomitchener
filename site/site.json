{
  "title": "carlomitchener",
  "name": "carlomitchener.com",
  "root": "https://carlomitchener.com",
  "since": 2013,
  "prefix": "cm-",
  "font": true,
  "settings": true,
  "menu": "/menu/",
  "cart": "/cart/",
  "tint": "blue",
  "live": 14,
  "country": "US",
  "api": "2026-07",
  "printful": "https://www.printful.com/custom/products/all/",
  "cdn": "/cdn/printful",
  "tiles": [1, 3, 5, 7, 9],
  "company": "MrlyProd, Inc.",
  "tagline": "One design at a time, and every printfile and tile is a free download.",
  "contact": "help@mrly.net",
  "tree": [
    { "name": "Home", "href": "/" },
    { "name": "Collections", "href": "/collections/", "fill": "collections", "open": true },
    { "name": "Cart", "href": "/cart/" },
    { "name": "Code", "href": "/git/" },
    { "name": "About", "href": "/about/" },
    { "name": "Contact", "href": "/contact/" },
    { "name": "FAQ", "href": "/faq/" }
  ],
  "socials": [
    { "name": "GitHub", "href": "https://github.com/carlomitchener" },
    { "name": "YouTube", "href": "https://www.youtube.com/@carlomitchener" },
    { "name": "Instagram", "href": "https://www.instagram.com/carlo.mitchener" },
    { "name": "X", "href": "https://twitter.com/carlomitchener" },
    { "name": "Pinterest", "href": "https://www.pinterest.com/carlomitchener" }
  ],
  "emoji": {
    "all": "💈",
    "accessories": "🧢",
    "bags": "🎒",
    "kids": "🧸",
    "men": "👨",
    "unisex": "🦄",
    "women": "👩",
    "youth": "🛼"
  },
  "git": { "root": "..", "slug": "carlomitchener/carlomitchener", "branch": "main" },
  "llms": {
    "about": "carlomitchener.com is a shop that publishes one design at a time. Every product is printed on demand by Printful and sold through Shopify; a design stays live for 14 days and then goes. Nothing digital is sold: every printfile and every tile on a product page is a free download. The whole repository behind the shop, the pipeline that makes the designs and the code that renders these pages, is browsable at /git/ and served byte for byte under /raw/.",
    "links": [
      { "href": "/collections/", "name": "Collections", "note": "every design, by category and by product" },
      { "href": "/git/", "name": "Code", "note": "the whole repository, browsable, raw bytes under /raw/" },
      { "href": "/raw/README.md", "name": "README", "note": "who Carlo is, in markdown" },
      { "href": "/faq/", "name": "FAQ", "note": "printing, shipping, returns and the 14 days" },
      { "href": "/contact/", "name": "Contact", "note": "where to write" }
    ]
  },
  "inputs": {
    "shop": { "path": "data/shop.json" },
    "catalog": { "path": "../shop/files/catalog.json" },
    "tasks": { "path": "data/tasks", "deep": true, "ext": ".json" },
    "pages": { "path": "pages", "ext": ".md" },
    "public": { "path": "public" }
  },
  "kit": {
    "path": "data/kit/ui",
    "out": "ui",
    "hash": false,
    "files": [
      "palette.css",
      "tokens.css",
      "base.css",
      "chrome.css",
      "chrome.js",
      "palette.js",
      "logo.js",
      "code.css",
      "seti/seti.css",
      "seti/seti.woff2",
      "font.js",
      "font.json",
      "savers/index.js",
      "savers/frame.js",
      "savers/gl.js",
      "savers/matrix.js",
      "savers/sleep.js",
      "savers/tiles.js",
      "savers/fractal.js",
      "fonts/fonts.css",
      "fonts/sans.woff2",
      "fonts/serif.woff2",
      "fonts/mono.woff2",
      "fonts/mrly.woff2",
      "fonts/symbols.ttf",
      "fonts/emoji.0.woff2",
      "fonts/emoji.1.woff2",
      "fonts/emoji.2.woff2",
      "fonts/emoji.3.woff2",
      "fonts/emoji.4.woff2",
      "fonts/emoji.5.woff2",
      "fonts/emoji.6.woff2",
      "fonts/emoji.7.woff2",
      "fonts/emoji.8.woff2",
      "fonts/emoji.9.woff2",
      "fonts/LICENSE-emoji.txt",
      "fonts/LICENSE-mono.txt",
      "fonts/LICENSE-sans.txt",
      "fonts/LICENSE-serif.txt",
      "fonts/LICENSE-symbols.txt"
    ]
  },
  "assets": [
    { "path": "ui", "out": "ui", "hash": true, "ext": ".css" },
    { "path": "js", "out": "js", "hash": true, "ext": ".js" }
  ],
  "robots": { "disallow": ["/cart/"] },
  "manifest": {
    "name": "carlomitchener.com",
    "short_name": "carlomitchener",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#070707",
    "theme_color": "#070707",
    "icons": [
      { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
      { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
      { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
    ]
  }
}
