{
  "name": "carlomitchener.com",
  "root": "https://carlomitchener.com",
  "owner": "Carlo Mats Vincenti Mitchener",
  "since": 1998,
  "tagline": "Life is a loop. But someday it ends.",
  "contact": "carlo@mrly.net",
  "socials": [
    { "name": "GitHub", "href": "https://github.com/carlomitchener" },
    { "name": "YouTube", "href": "https://www.youtube.com/@carlomitchener" },
    { "name": "Instagram", "href": "https://www.instagram.com/carlo.mitchener" },
    { "name": "X", "href": "https://twitter.com/carlomitchener" },
    { "name": "Pinterest", "href": "https://www.pinterest.com/carlomitchener" },
    { "name": "Reddit", "href": "https://www.reddit.com/user/carlomitchener" },
    { "name": "Donate", "href": "https://donate.stripe.com/dRm3cu3XLfHj19e6WW5kk00" },
    { "name": "MrlyNet", "href": "https://mrly.net" }
  ],
  "inputs": {
    "shop": { "path": "../../data/carlomitchener/site/shop.json" },
    "feed": { "path": "../../data/carlomitchener/site/feed.json" },
    "catalog": { "path": "../shop/files/catalog.json" },
    "reviews": { "path": "../shop/files/reviews.json" },
    "tasks": { "path": "../../data/carlomitchener/site/tasks", "deep": true, "ext": ".json" },
    "pages": { "path": "pages", "ext": ".md" },
    "readme": { "path": "../README.md" },
    "public": { "path": "public" }
  },
  "push": {
    "prefix": "site/",
    "guard": ["cdn/", "art/", "automator/automator.json", "stats/stats.json"],
    "bucket": "CARLOMITCHENER_BUCKET",
    "store": { "bucket": "CARLOMITCHENER_BUCKET", "prefix": "data/build" },
    "hashed": ["(^|/)lib-[^/]+\\.js$", "(^|/)lib-[^/]+\\.css$", "(^|/)js/[^/]+\\.js$", "\\.wasm$", "-[0-9a-f]{8}\\.[^./]+$"]
  },
  "robots": { "disallow": ["/cart/"] },
  "llms": {
    "about": "carlomitchener.com is Carlo Mitchener's shop. A generator paints a Game of Life design, a pipeline prints it on demand through Printful and sells it through Shopify, and every variation lives one lunar month, 29.53 days, then it is gone and never printed again. Nothing digital is sold: every printfile and every tile on a product page is a free download. The shop lives under /shop/, one page per variation at /shop/{product}/{design}/; the feed of generated posts lives at /feed/.",
    "links": [
      { "href": "/shop/", "name": "Shop", "note": "every live variation, by category and by product" },
      { "href": "/shop/designs/", "name": "Designs", "note": "one tile per design" },
      { "href": "/shop/gift-card/", "name": "Gift Card", "note": "mini, medi and maxi, sent by email" },
      { "href": "/shop/faq/", "name": "FAQ", "note": "how the shop works" },
      { "href": "/shop/shipping/", "name": "Shipping", "note": "who prints and who ships" },
      { "href": "/shop/terms/", "name": "Terms", "note": "the terms of sale" },
      { "href": "/about/", "name": "About", "note": "who Carlo is" },
      { "href": "/contact/", "name": "Contact", "note": "where to write" },
      { "href": "/privacy/", "name": "Privacy", "note": "what the site stores" },
      { "href": "/feed/", "name": "Feed", "note": "every generated post, newest first" },
      { "href": "/pages/", "name": "Pages", "note": "every route this site serves" }
    ]
  },
  "manifest": {
    "name": "carlomitchener.com",
    "short_name": "carlomitchener",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#ffffff",
    "icons": [
      { "src": "/bird/bird-192.png", "sizes": "192x192", "type": "image/png" },
      { "src": "/bird/bird-512.png", "sizes": "512x512", "type": "image/png" }
    ]
  }
}
