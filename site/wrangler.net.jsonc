{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carlomitchener",
  "main": "edge.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "routes": [
    { "pattern": "carlomitchener.com", "custom_domain": true },
    { "pattern": "www.carlomitchener.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../data/site/net/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
