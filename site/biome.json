{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": true,
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!node_modules", "!wasm", "!**/*.svg", "!public/stats.json", "!site.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120,
    "includes": ["**"]
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAriaHiddenOnFocusable": "off",
        "noStaticElementInteractions": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "correctness": {
        "noComponentHookFactories": "off",
        "useExhaustiveDependencies": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
